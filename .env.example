
# SERVER
PORT=3000

# ADMIN LOGIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ESP32
ESP32_IP=Adjust it to match the IP in the .ino file
ESP32_PORT=80
ESP32_API_KEY=CHANGE_THIS_ESP32_API_KEY

# SESSION
SESSION_TTL_HOURS=24

# EXTERNAL STORAGE
# A single connected flash drive is detected automatically.
STORAGE_FOLDER=upload

# WEB TERMINAL
TERMINAL_ENABLED=true
TERMINAL_SHELL=
TERMINAL_CWD=
TERMINAL_TIMEOUT_S=300
TERMINAL_MAX_OUTPUT_KB=512
TERMINAL_MAX_JOBS=4

# RELAY
RELAY_LABELS=Relay 1

# POWER / BATTERY MONITORING
I_WARN_A=5
CELL_V_MAX=4.20
CELL_V_CRIT=3.00
CELL_V_LOW=3.50
CELL_DELTA_WARN=0.10
I_DEADBAND_A=0.10
AC_VOLTAGE_NOMINAL=220
AC_POWER_FACTOR=0.80

# TELEGRAM
# Enables Telegram alerts, including low-battery notifications.
TELEGRAM_ALERTS=true
TELEGRAM_BOT_TOKEN=CHANGE_THIS_TELEGRAM_BOT_TOKEN
# Private Telegram chat ID allowed to run bot commands.
TELEGRAM_CHAT_ID=CHANGE_THIS_TELEGRAM_CHAT_ID

# DOOR LOCK
DOOR_IP=Adjust it to match the IP in the .ino file
DOOR_PORT=80
DOOR_API_KEY=CHANGE_THIS_DOOR_API_KEY
DOOR_ENROLL_SECONDS=30
DOOR_POLL_MS=1000
DOOR_NOTIFY_OPEN=false
DOOR_NOTIFY_UNKNOWN=false

# LANGUAGE
LANGUAGE=id
