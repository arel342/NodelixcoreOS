# ============================================================================
#   NodelixcoreOS — contoh isi .env
#
#   File ini TIDAK wajib diisi manual lagi: saat pertama kali dijalankan, server
#   menampilkan alamat setup (mis. http://192.168.1.20:3000/setup.html). Buka di
#   browser, lalu ikuti langkahnya — semua nilai di bawah ditulis otomatis ke .env.
#   Setelah itu pengaturan bisa diubah kapan saja dari tab "Pengaturan" di web
#   (ESP32, ESP8266/pintu, Telegram, AI Agent/Gemini, akun admin, batas monitoring).
#
#   Salin file ini menjadi .env hanya kalau ingin mengisi manual:
#       cp .env.example .env
# ============================================================================

# SERVER
PORT=3000
# Timeout request body (ms); 15 menit default, 30 detik..1 jam.
REQUEST_TIMEOUT_MS=900000
# Timeout header dan keep-alive socket (ms).
HEADERS_TIMEOUT_MS=60000
KEEP_ALIVE_TIMEOUT_MS=5000

# SETUP AWAL
# 1 = panduan setup (halaman /setup.html) sudah selesai dijalankan.
SETUP_DONE=0

# ADMIN LOGIN
# Dibuat lewat halaman setup di browser (tidak perlu diisi dari sini).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ESP32 MONITOR (PLTS)
# Diisi dari halaman setup atau tab Pengaturan. Nama WiFi, password WiFi, IP, dan
# kunci API juga diisi di halaman pengaturan ESP32 sendiri (mode setup 192.168.4.1),
# jadi tidak perlu mengedit file .ino.
ESP32_IP=
ESP32_PORT=80
ESP32_API_KEY=
ESP32_POLL_MS=1000

# ESP8266 PINTU RFID (lock door)
DOOR_IP=
DOOR_PORT=80
DOOR_API_KEY=
DOOR_ENROLL_SECONDS=30
DOOR_POLL_MS=1000
DOOR_NOTIFY_OPEN=false
DOOR_NOTIFY_UNKNOWN=false

# SESSION
# Masa berlaku cookie `sid` dashboard web (jam). Sesi web disimpan di memori,
# jadi restart server = login ulang di browser (perilaku lama).
SESSION_TTL_HOURS=24

# APLIKASI ANDROID (NodelixcoreOS Mobile) — autentikasi ECDSA P-256 + Bearer
# Aktif secara default. false = endpoint /api/mobile/* menjawab 404 dan aplikasi
# otomatis memakai login web biasa (cookie sid).
MOBILE_AUTH_ENABLED=true
# Masa berlaku sesi mobile (jam). Token disimpan sebagai hash di
# data/mobile-sessions.json (mode 600), jadi tetap berlaku setelah restart.
MOBILE_SESSION_TTL_HOURS=720
# Umur challenge login biometrik dan toleransi selisih jam perangkat (milidetik).
MOBILE_CHALLENGE_TTL_MS=60000
MOBILE_CHALLENGE_SKEW_MS=60000
MOBILE_MAX_PENDING_CHALLENGES=2000
# Jumlah maksimum sesi aktif per perangkat (1-100). Login ke-11 dari perangkat yang
# sama mencabut token paling lama, jadi daftar sesi tidak tumbuh tanpa batas.
MOBILE_MAX_SESSIONS_PER_DEVICE=10
# Opsional: origin publik server bila berada di balik reverse proxy TLS,
# mis. https://192.168.1.10:8443 (pisahkan dengan koma bila lebih dari satu).
# MOBILE_AUTH_SERVER_ORIGIN=

# BATAS PERMINTAAN & UPLOAD
# Batas body JSON (mis. 512kb) dan batas satu berkas upload ke flash disk (MB,
# 0 = tanpa batas). OTA firmware memakai OTA_MAX_MB di bagian lain.
JSON_BODY_LIMIT=512kb
UPLOAD_MAX_MB=2048

# HEADER KEAMANAN
# true = izinkan dashboard ditempel di iframe situs lain (default: ditolak).
ALLOW_IFRAME=false
HSTS_MAX_AGE=15552000

# REVERSE PROXY (opsional)
# Daftar IP/CIDR proxy tepercaya, dipisahkan koma (contoh: 127.0.0.1,10.0.0.10).
# Jangan gunakan TRUST_PROXY=true: nilai tersebut tidak lagi diterima karena terlalu luas.
TRUST_PROXY=false
# Jika TLS diakhiri di reverse proxy dan Host publik tidak diteruskan, tetapkan origin ini
# agar autentikasi Android menandatangani origin yang dipercaya server.
# MOBILE_AUTH_SERVER_ORIGIN=https://nodelix.example
# Origin tambahan yang diizinkan untuk permintaan non-GET bercookie (CSRF), mis.
# TRUSTED_ORIGINS=https://192.168.1.10:8443

# EXTERNAL STORAGE
# A single connected flash drive is detected automatically.
STORAGE_FOLDER=upload
# direct = tanpa su (folder biasa / Node berjalan sebagai root), root = lewat su (Termux biasa)
# STORAGE_MODE=root
# STORAGE_DEVICE=/mnt/media_rw/XXXX-XXXX

# WEB TERMINAL
TERMINAL_ENABLED=false
TERMINAL_SHELL=
TERMINAL_CWD=
TERMINAL_TIMEOUT_S=300
TERMINAL_MAX_OUTPUT_KB=512
TERMINAL_MAX_JOBS=4
TERMINAL_MAX_CMD=10000

# RELAY
RELAY_LABELS=Relay 1 & 2, Relay 3, Relay 4

# POWER / BATTERY MONITORING
I_WARN_A=5
CELL_V_MAX=4.20
CELL_V_CRIT=3.00
CELL_V_LOW=3.50
CELL_DELTA_WARN=0.10
I_DEADBAND_A=0.10
AC_VOLTAGE_NOMINAL=220
AC_POWER_FACTOR=0.80

# TELEGRAM
# Enables Telegram alerts, including low-battery notifications.
TELEGRAM_ALERTS=true
TELEGRAM_BOT_TOKEN=
# Private Telegram chat ID allowed to run bot commands.
TELEGRAM_CHAT_ID=

# UPDATE FIRMWARE ESP (OTA, file .bin dari tab "Update Firmware" atau menu Termux: npm run update-fw)
# Ukuran maksimal file .bin yang diterima web (MB) - firmware ESP biasanya 300-1000 KB.
OTA_MAX_MB=4
# Batas waktu server mengirim firmware ke ESP dan menunggu ESP hidup lagi setelah restart (detik).
OTA_TIMEOUT_S=240
OTA_WAIT_S=60

# UPDATE GITHUB (deteksi + notifikasi saja — pemasangan tetap manual)
# Pemeriksa update menjalankan `git fetch origin` tiap interval lalu membandingkan commit
# terpasang dengan origin/main. `git pull` TIDAK pernah dijalankan otomatis.
UPDATE_CHECK_ENABLED=true
# 12 jam = 43200000 ms
UPDATE_CHECK_INTERVAL=43200000
UPDATE_REPO=arel342/NodelixcoreOS
UPDATE_BRANCH=main
UPDATE_REPO_URL=https://github.com/arel342/NodelixcoreOS
# Jeda pemeriksaan pertama setelah server mulai (ms) dan batas waktu git (ms)
UPDATE_CHECK_START_DELAY_MS=15000
UPDATE_FETCH_TIMEOUT_MS=60000
UPDATE_GIT_TIMEOUT_MS=15000
# Jeda percobaan ulang notifikasi Telegram yang gagal (ms) & backoff saat rate limit (ms)
UPDATE_NOTIFY_RETRY_MS=900000
UPDATE_RATE_LIMIT_BACKOFF_MS=3600000
# Alamat dashboard di pesan Telegram. Kosong = dipakai alamat LAN server otomatis.
UPDATE_DASHBOARD_URL=
# Parse mode pesan Telegram bot: kosong = teks biasa (aman), html | markdown | markdownv2
TELEGRAM_PARSE_MODE=

# LANGUAGE
LANGUAGE=id

# AI AGENT (Gemini, free tier dari Google AI Studio)
# Kunci API diisi lewat langkah "AI Agent (Gemini)" di halaman setup awal, atau dari
# tab Pengaturan > AI Agent — tidak perlu mengedit bagian ini manual. Buat kunci gratis
# di https://aistudio.google.com/apikey, lalu tempel nilainya di sana.
# AI_AGENT_ENABLED=false mematikan /ai di Telegram tanpa menghapus kuncinya.
AI_AGENT_ENABLED=true
GEMINI_API_KEY=
# Model TIDAK diganti otomatis. Hanya awalan "models/" yang dibuang.
GEMINI_MODEL=gemini-3.5-flash-lite
# Cadangan dipakai bila model utama ditolak/tidak tersedia (bukan pengganti diam-diam).
GEMINI_FALLBACK_ENABLED=true
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_FALLBACK_ON_QUOTA=false
# true = coba model yang disarankan pesan error Google (bisa berpindah tier biaya).
GEMINI_HONOR_MODEL_SUGGESTION=false
GEMINI_RETRY_MAX=2
GEMINI_RETRY_DELAY_MS=1200
GEMINI_TIMEOUT_S=60
AI_MAX_ROUNDS=8
AI_MAX_TOOL_CALLS=12
AI_JOB_TIMEOUT_S=120
AI_COMMAND_TIMEOUT_S=30

# KONFIRMASI TINDAKAN SENSITIF (detik; 30..3600)
CONFIRM_TTL_S=300

# AUDIT TINDAKAN AI/SKILL (JSONL, rotasi)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_MB=2

# RIWAYAT AI (dibatasi agar ringan di HP)
AI_HISTORY_PERSIST=true
AI_HISTORY_MAX_TOKENS=6000
AI_HISTORY_MAX_TURNS=12
AI_HISTORY_MAX_SESSIONS=20
AI_HISTORY_MAX_KB=512

# JADWAL & OTOMASI (zona waktu interaksi)
SCHEDULE_TZ=Asia/Jakarta
# skip = jadwal terlewat saat server mati tidak dijalankan; run-once = sekali bila masih wajar
SCHEDULE_MISSED_POLICY=skip
SCHEDULE_MAX_LATE_S=300
AUTOMATION_EVAL_MS=2000
SENSOR_STALE_S=120

# RIWAYAT SENSOR (untuk get_sensor_history & automasi)
SENSOR_HISTORY_HOURS=24
SENSOR_HISTORY_MAX_POINTS=6000
SENSOR_HISTORY_MIN_INTERVAL_S=15
SENSOR_HISTORY_PERSIST=false

# FITUR OPSIONAL: analisis dokumen & transkripsi suara (default MATI)
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_PROVIDER=gemini
DOCUMENT_AI_MODEL=gemini-3.5-flash-lite
DOCUMENT_AI_MAX_MB=5
VOICE_AI_ENABLED=false
VOICE_AI_PROVIDER=gemini
VOICE_AI_MODEL=gemini-3.5-flash-lite
VOICE_AI_LANGUAGE=id
VOICE_AI_MAX_MB=8
OPTIONAL_AI_TIMEOUT_S=60

# ANTREAN BOT TELEGRAM
TELEGRAM_MAX_JOBS=2
# Jeda sebelum pesan "sedang diproses" (ms; 0 = langsung)
TELEGRAM_NOTICE_MS=1500
